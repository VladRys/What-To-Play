FROM python:3.13-slim

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY backend/app/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire project
COPY . .

# Set environment variables
ENV DB_PATH=/app/app.db

# Build argument for Steam API key
ARG STEAM_API_KEY
ENV STEAM_API_KEY=${STEAM_API_KEY}

# Build the database (requires STEAM_API_KEY)
RUN if [ -n "$STEAM_API_KEY" ]; then python -m backend.app.services.steam_db_builder; else echo "Warning: STEAM_API_KEY not provided, database will not be built"; fi

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]